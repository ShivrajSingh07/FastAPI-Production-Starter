APP_NAME=fastapi-production-starter
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Local development only. Use a strong, unique secret in production.
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local Docker Compose database. Do not reuse these credentials in production.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fastapi_starter
DATABASE_ECHO=false

# Comma-separated origins. Set explicit production origins; do not use "*" with credentials.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
